# LOCAL DEVELOPMENT ONLY. Generate unique secrets before enabling graph functionality.
POSTGRES_PASSWORD=replace_with_secure_local_password
# Initially keep false until schema 001-004 is installed and tested.
HOMEOS_MEMORY_ENABLED=false
HOMEOS_MEMORY_SOURCE_PATH=../homeos-github/services/memory
# Use the existing M2C household UUID (from /api/setup-state).
HOMEOS_HOUSEHOLD_ID=replace_with_existing_household_uuid
HOMEOS_API_TOKEN=replace_with_random_owner_token
HOMEOS_WORKER_TOKEN=replace_with_different_random_worker_token
# Only set when you explicitly want to send image frames to the model provider.
HOMEOS_VISION_API_KEY=
HOMEOS_VISION_MODEL=gpt-4.1-mini
