# Synthetic-only local sandbox. NEVER reuse your existing HomeOS DB password.
POSTGRES_PASSWORD=change_this_to_a_new_sandbox_password
HOMEOS_MEMORY_ENABLED=false
HOMEOS_HOUSEHOLD_ID=
HOMEOS_API_TOKEN=
HOMEOS_WORKER_TOKEN=
HOMEOS_VISION_API_KEY=
HOMEOS_VISION_MODEL=gpt-4.1-mini
HOMEOS_CHAT_EXTERNAL_ENABLED=false
HOMEOS_CHAT_API_KEY=
HOMEOS_CHAT_MODEL=gpt-4.1-mini
# Model-driven JARVIS is opt-in and sends chat/tool results to the provider.
HOMEOS_JARVIS_AGENT_ENABLED=false
HOMEOS_JARVIS_AGENT_API_KEY=
HOMEOS_JARVIS_AGENT_MODEL=gpt-4.1-mini
