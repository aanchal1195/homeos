# Set this to the SAME password as your existing HomeOS PostgreSQL instance.
POSTGRES_PASSWORD=replace_with_current_db_password
# Keep memory disabled until the database backup and schema migrations pass.
HOMEOS_MEMORY_ENABLED=false
# Set to your EXISTING household UUID, not a newly generated household.
HOMEOS_HOUSEHOLD_ID=
HOMEOS_API_TOKEN=
HOMEOS_WORKER_TOKEN=
# Set only if you explicitly agree to send household images to OpenAI for analysis.
HOMEOS_VISION_API_KEY=
HOMEOS_VISION_MODEL=gpt-4.1-mini
